<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101816"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#203B31"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ScamShield"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Your online security dashboard"
            android:textColor="#AABBB4"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#203B31"
            android:padding="10dp"
            android:text="Connecting to Firebase..."
            android:textColor="#55DDA6"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Security Overview"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="true">

            <!-- Total Scans -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#20312D"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Scans"
                    android:textColor="#B9C9C2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTotalScans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- High Risk -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#20312D"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High-Risk Detections"
                    android:textColor="#B9C9C2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvHighRisk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0"
                    android:textColor="#FFB36B"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- URL Scans -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#20312D"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URL Scans"
                    android:textColor="#B9C9C2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUrlScans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Message Scans -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#20312D"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Message Scans"
                    android:textColor="#B9C9C2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMessageScans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </GridLayout>

        <TextView
            android:id="@+id/tvLastScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#20312D"
            android:padding="16dp"
            android:text="Last scan: No scans yet"
            android:textColor="#D5E2DC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#16A875"
            android:text="Refresh Statistics"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
